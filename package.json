{
  "name": "@j3pf/piquota",
  "version": "0.11.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Read-only quota monitor for the AI provider credentials Pi already owns: terminal CLI, Pi TUI line, and JSON engine for rp-host and automations",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "piquota": "./bin/piquota.js"
  },
  "files": [
    "bin",
    "src",
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "quota",
    "ai-agents",
    "rate-limits",
    "claude",
    "codex",
    "antigravity",
    "opencode"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/J3pf/piQuota.git"
  },
  "bugs": {
    "url": "https://github.com/J3pf/piQuota/issues"
  },
  "homepage": "https://github.com/J3pf/piQuota#readme",
  "pi": {
    "extensions": [
      "./extensions/quota-panel.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "quota": "node bin/piquota.js",
    "quota:json": "node bin/piquota.js --json"
  },
  "license": "MIT"
}
